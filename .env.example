# DESARROLLO LOCAL (Mac o Windows): comienza con SQLite.
DB_ENGINE=sqlite
DJANGO_DEBUG=True
# Opcional en local; OBLIGATORIO en Vercel (crear clave propia).
# DJANGO_SECRET_KEY=una-clave-secreta-larga-y-aleatoria

# SUPABASE: cambia DB_ENGINE a supabase y pega los datos de Connect.
# Local: Session pooler 5432. Vercel: Transaction pooler 6543.
DB_HOST=HOST_EXACTO_COPIADO_DESDE_SUPABASE
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.ID_DEL_PROYECTO
DB_PASSWORD=CONTRASENA_POSTGRES
